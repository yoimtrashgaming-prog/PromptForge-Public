# Line endings. This project is built on Windows and deployed to Linux via
# flash drive. Without this file, .sh scripts carry CRLF endings and fail on
# Linux with "/bin/bash^M: bad interpreter", which reads like a broken script
# rather than an encoding problem.

* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

*.sh   text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf

*.png         binary
*.jpg         binary
*.jpeg        binary
*.webp        binary
*.safetensors binary
*.gguf        binary
*.onnx        binary
*.zip         binary
*.sqlite      binary
